root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,toml}]
indent_style = space
indent_size = 4

[*.{json,jsonc,js,mjs,cjs,ts,tsx,jsx,css,scss,html,xml,svg,yml,yaml}]
indent_style = space
indent_size = 2

[*.{ps1,cmd,bat}]
end_of_line = crlf
indent_style = space
indent_size = 4

[*.sh]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
